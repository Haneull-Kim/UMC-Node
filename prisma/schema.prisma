generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            BigInt     @id @default(autoincrement()) 
  name          String     @db.VarChar(20)
  gender        Int?       
  birth         DateTime?  @db.Date
  address       String?    @db.Text
  status        Int?
  createdAt     DateTime?  @map("created_at") @db.DateTime
  updatedAt     DateTime?  @map("updated_at") @db.DateTime
  inactiveDate  DateTime?  @map("inactive_date") @db.DateTime
  email         String     @db.VarChar(40) @unique
  phoneNumber   String?    @map("phone_number") @db.VarChar(11)
  phoneAuth     Int?       @map("phone_auth")
  image         String?    @db.Text

  userFoods      UserFood[]  
  userOptions    UserOption[] 

  @@map("user") 
}

model FoodCategory {
  id   BigInt   @id @default(autoincrement()) 
  name String?  @db.VarChar(20)

  userFoods     UserFood[] 

  @@map("food_category")
}

model UserFood {
  id               BigInt   @id @default(autoincrement()) 
  userId           BigInt?  @map("user_id")
  foodCategoryId   BigInt?  @map("food_category_id")

  user             User?    @relation(fields: [userId], references: [id]) 
  foodCategory     FoodCategory? @relation(fields: [foodCategoryId], references: [id]) 

  @@map("user_food")
}

model OptionCategory {
  id          BigInt   @id @default(autoincrement()) 
  description String?  @db.Text

  userOptions  UserOption[] 

  @@map("option_category")
}

model UserOption {
  id                 BigInt   @id @default(autoincrement()) 
  userId             BigInt?  @map("user_id")
  optionCategoryId   BigInt?  @map("option_category_id")

  user               User?    @relation(fields: [userId], references: [id]) 
  optionCategory     OptionCategory? @relation(fields: [optionCategoryId], references: [id]) 

  @@map("user_option")
}